{
    "name": "quickmart-ioms-frontend-build",
    "version": "1.0.0",
    "private": true,
    "description": "Reproducible production CSS generation for QuickMart IOMS",
    "scripts": {
        "build:css": "node scripts/build-css.js",
        "build:js": "node scripts/build-js.js",
        "build": "npm run build:css && npm run build:js",
        "dev": "node server.js",
        "start": "node server.js",
        "lint": "node --check server.js src/**/*.js scripts/*.js"
    },
    "devDependencies": {
        "clean-css": "5.3.3",
        "terser": "5.50.0"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "express": "^5.3.0"
    }
}
