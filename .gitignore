# Environment variables and secrets
.env
.env.*
!.env.example

# Node dependencies and logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Caches, backups, and temporary files
*.tmp
*.temp
*.bak
*.backup
cache/
tmp/
temp/
logs/
backups/

# Operating system and editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Build output handling
build/
dist/

# Checked-in production CSS generated by build pipeline
!dist/
!dist/css/
!dist/css/*.min.css

# Checked-in production JavaScript generated by build pipeline
!dist/js/
!dist/js/*.min.js

# Self-hosted vendor assets
!assets/vendor/
!assets/vendor/bootstrap/
!assets/vendor/bootstrap/*
